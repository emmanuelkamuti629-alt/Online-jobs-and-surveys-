# ── Server ──
PORT=3000
NODE_ENV=development

# ── MongoDB ──
MONGODB_URI=mongodb://127.0.0.1:27017/payhero_jobs

# ── JWT ──
JWT_SECRET=change_this_to_a_long_random_string

# ── PayHero ──
PAYHERO_API_KEY=your_payhero_api_key
PAYHERO_USERNAME=your_payhero_username
# This must be a publicly reachable URL for PayHero to POST the callback
PAYHERO_CALLBACK_URL=https://your-domain.com/api/payhero/callback

# ─── Business rules (client reads these via /api/config) ───
MIN_DEPOSIT=50
MAX_DEPOSIT=150000
MIN_WITHDRAWAL=200
MAX_WITHDRAWAL=50000
ACTIVATION_FEE=499
REFERRAL_BONUS=50
FREE_DAILY_TASKS=2
FREE_TASK_REWARD=21
```
